<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0A1014"
                android:startColor="#1A262C" />
        </shape>
    </item>

    <item android:top="-40dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#1B272E"
                android:endColor="#0C1317"
                android:startColor="#2B383E" />
        </shape>
    </item>

    <item android:left="24dp" android:top="72dp" android:right="24dp" android:bottom="180dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#D9FF6B"
                android:endColor="#0CF02B"
                android:gradientRadius="230dp"
                android:startColor="#A7FF15"
                android:type="radial" />
            <size
                android:width="320dp"
                android:height="320dp" />
        </shape>
    </item>

    <item android:left="42dp" android:top="90dp" android:right="42dp" android:bottom="198dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#ECFFBC"
                android:endColor="#1CBB00"
                android:gradientRadius="180dp"
                android:startColor="#66FF00"
                android:type="radial" />
            <size
                android:width="280dp"
                android:height="280dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7A081014" />
        </shape>
    </item>
</layer-list>
