<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.RickAndMortyApp.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/app_surface</item>
        <item name="titleTextColor">@color/app_text</item>
        <item name="subtitleTextColor">@color/app_muted</item>
        <item name="navigationIconTint">@color/app_text</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.RickAndMortyApp.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="Widget.RickAndMortyApp.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Widget.RickAndMortyApp.Subtitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/app_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.RickAndMortyApp.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/app_text</item>
    </style>

    <style name="Widget.RickAndMortyApp.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.RickAndMortyApp.Caption" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/app_muted</item>
    </style>

    <style name="Widget.RickAndMortyApp.Meta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/app_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.RickAndMortyApp.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/app_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.RickAndMortyApp.HeroCard" parent="Widget.RickAndMortyApp.Card">
        <item name="cardBackgroundColor">@color/app_surface_variant</item>
        <item name="cardCornerRadius">@dimen/card_radius_large</item>
    </style>

    <style name="Widget.RickAndMortyApp.SoftCard" parent="Widget.RickAndMortyApp.Card">
        <item name="cardBackgroundColor">@color/app_surface_low</item>
    </style>

    <style name="Widget.RickAndMortyApp.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="backgroundTint">@color/app_primary</item>
        <item name="android:textColor">@color/app_on_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/app_secondary</item>
    </style>

    <style name="Widget.RickAndMortyApp.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/app_border</item>
        <item name="android:textColor">@color/app_text</item>
    </style>

    <style name="Widget.RickAndMortyApp.CompactSecondaryButton" parent="Widget.RickAndMortyApp.SecondaryButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.RickAndMortyApp.TonalButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="backgroundTint">@color/app_primary_container</item>
        <item name="android:textColor">@color/app_on_primary_container</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RickAndMortyApp.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/app_surface_low</item>
        <item name="boxStrokeColor">@color/app_border</item>
        <item name="hintTextColor">@color/app_muted</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
    </style>

    <style name="Widget.RickAndMortyApp.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox.Dense">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textColorHint">@color/app_muted</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.RickAndMortyApp.FormTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/app_surface_low</item>
        <item name="boxStrokeColor">@color/app_border</item>
        <item name="hintTextColor">@color/app_muted</item>
        <item name="placeholderTextColor">@color/app_muted</item>
        <item name="startIconTint">@color/app_muted</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
    </style>

    <style name="Widget.RickAndMortyApp.FormEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textColorHint">@color/app_muted</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.RickAndMortyApp.FilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/app_surface_variant</item>
        <item name="chipStrokeColor">@color/app_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/chip_radius</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="checkedIconVisible">false</item>
    </style>
    
    <style name="Widget.RickAndMortyApp.StatusChip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="chipCornerRadius">@dimen/chip_radius</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="chipMinHeight">30dp</item>
        <item name="chipBackgroundColor">@color/app_surface_high</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

    <style name="Widget.RickAndMorty.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="android:background">@color/app_surface_highest</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/app_scrim</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">4dp</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.RickAndMortyApp.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.RickAndMortyApp.BottomNav.Inactive</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.RickAndMortyApp.BottomNavigation" parent="Widget.RickAndMorty.BottomNavigationView" />

    <style name="TextAppearance.RickAndMortyApp.BottomNav.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.RickAndMortyApp.BottomNav.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
    </style>
</resources>
